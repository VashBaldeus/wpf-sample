<Window x:Class="DataBrowserBox.Lib.DataBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBrowserBox.Lib"
        mc:Ignorable="d"
        Title="DataBrowserDialog" Height="450" Width="800">
    <DockPanel Margin="8">

        <!-- Filter -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Height="20"
                     Margin="0,0,0,6"
                     x:Name="FilterTextBox"
                     TextChanged="FilterTextBox_TextChanged"/>

            <Button x:Name="ClearFilter"
                    Content="X" 
                    Width="32" 
                    BorderThickness="0 1 1 1" 
                    Grid.Column="1" 
                    VerticalAlignment="Top" 
                    Height="{Binding ElementName=FilterTextBox, Path=Height}"
                    Click="ClearFilter_OnClick"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,6,0,0">
            <Button Content="OK"
                    Width="80"
                    IsDefault="True"
                    Margin="0,0,6,0"
                    Click="Ok_Click"/>
            <Button Content="Cancel"
                    Width="80"
                    IsCancel="True"/>
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="Grid"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="Grid_SelectionChanged"
                  MouseDoubleClick="Grid_OnMouseDoubleClick"/>
    </DockPanel>
</Window>

<Window x:Class="DataBrowserBox.Demo.MainWindow"
        x:Name="root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBrowserBox.Demo"
        xmlns:lib="clr-namespace:DataBrowserBox.Lib;assembly=DataBrowserBox.Lib"
        xmlns:models="clr-namespace:DataBrowserBox.Lib.Models;assembly=DataBrowserBox.Lib"
        mc:Ignorable="d"
        Title="DataBrowserBox Control Demo" Height="450" Width="800">
    <StackPanel>
        <GroupBox Header="Example 1: Auto-generated Columns" Margin="5">
            <lib:DataBrowserBox ItemsSource="{Binding Products}" Margin="5"
                SelectedItem="{Binding Auto}"
                DisplayMemberPath="Name"
                DialogTitle="Select Product"/>
        </GroupBox>

        <GroupBox Header="Example 2: Custom Columns" Margin="5">
            <lib:DataBrowserBox ItemsSource="{Binding Products}" Margin="5"
                                SelectedItem="{Binding Custom}"
                                DisplayMemberPath="Name"
                                DialogTitle="Select Product">
                <lib:DataBrowserBox.Columns>
                    <models:BrowserColumn Header="קוד" DataField="Code" Width="Auto"/>
                    <models:BrowserColumn Header="שם פריט" DataField="Name" Width="*"/>
                    <models:BrowserColumn Header="קטגוריה" DataField="Category" Width="*"/>
                </lib:DataBrowserBox.Columns>
            </lib:DataBrowserBox>
        </GroupBox>
    </StackPanel>
</Window>

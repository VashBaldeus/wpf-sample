<UserControl x:Class="DataBrowserBox.Lib.DataBrowserBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataBrowserBox.Lib"
             xmlns:converters="clr-namespace:DataBrowserBox.Lib.Converters"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:DisplayMemberConverter x:Key="DisplayMemberConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="Text" Grid.Column="0" IsReadOnly="True">
            <TextBox.Text>
                <MultiBinding Converter="{StaticResource DisplayMemberConverter}" Mode="OneWay">
                    <Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType={x:Type local:DataBrowserBox}}" />
                    <Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource AncestorType={x:Type local:DataBrowserBox}}" />
                </MultiBinding>
            </TextBox.Text>
        </TextBox>

        <Button
            Grid.Column="1"
            Content=". . ."
            Width="32"
            ToolTip="Browse Items"
            Click="BrowseButton_Click"
            BorderThickness="0,1,1,1"/>
    </Grid>
</UserControl>
